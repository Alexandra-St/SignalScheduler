<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Padding" Value="18" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#50808080" />
    <Setter Property="Background" Value="#0E808080" />
  </Style>
  <Style Selector="TextBlock.validationError">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="#E47777" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.field">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="WrapPanel.actions > Button">
    <Setter Property="Margin" Value="0,0,8,8" />
  </Style>
  <Style Selector="TextBox.invalid">
    <Setter Property="BorderBrush" Value="#D05050" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
</Styles>
